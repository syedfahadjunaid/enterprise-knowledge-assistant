# Copy this file to .env (which is git-ignored):
#   Copy-Item .env.example .env
#
# These are LOCAL DEVELOPMENT values only. Never reuse them anywhere real.
# The backend also reads ../.env when you run it (or its tests) from backend/.

POSTGRES_SUPERUSER_PASSWORD=dev-postgres-superuser
EKA_OWNER_DB_PASSWORD=dev-eka-owner
EKA_APP_DB_PASSWORD=dev-eka-app
EKA_WORKER_DB_PASSWORD=dev-eka-worker
KEYCLOAK_DB_PASSWORD=dev-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
REDIS_PASSWORD=dev-redis

# Host ports (non-standard so they don't clash with other local Postgres/Redis instances,
# including the HRMS project's 15432/16379)
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379

# Optional: set this to get real answers from Claude.
# Left empty, the assistant runs in offline mode: it streams the best-matching passages,
# still cited and still permission-filtered, without calling any LLM.
ANTHROPIC_API_KEY=
